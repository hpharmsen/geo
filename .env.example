# Kopieer dit bestand naar .env en vul je echte keys in.
# .env staat in .gitignore en wordt nooit gecommit.

# Verplicht voor een echte meting (minimaal één provider):
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optioneel — modellen overschrijven:
# OPENAI_MODEL=gpt-4o
# PERPLEXITY_MODEL=sonar
# GEMINI_MODEL=gemini-flash-latest
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optioneel — meet-parameters:
# GEO_TEMPERATURE=0.7
# GEO_MAX_CONCURRENCY=5
